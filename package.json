{
  "name": "hanging-rope",
  "productName": "悬挂绳",
  "version": "2.0.0",
  "description": "悬挂绳 —— 常驻屏幕顶端的文件中转站，拖上去挂着，用的时候拖下来。",
  "main": "src/main/main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.js",
    "test": "node test/run-tests.js",
    "test:unit": "node test/run-tests.js unit",
    "test:e2e": "node test/run-tests.js e2e",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.hangingrope",
    "productName": "悬挂绳",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "legalTrademarks": "本地工具，无第三方商标"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "悬挂绳",
      "artifactName": "悬挂绳-安装版-${version}.${ext}"
    },
    "portable": {
      "artifactName": "悬挂绳-免安装-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
